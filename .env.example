# PhD Outreach Pipeline v3.7 - Local Environment Configuration Template
# Duplicate this file to .env and insert your deployed Web App URL:
# cp .env.example .env

# Google Apps Script Web App URL (from Deploy > Manage deployments > Web app URL)
PHD_GAS_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# Shared Secret (matches APP_SECRET in Google Apps Script Script Properties)
PHD_APP_SECRET=phd_pipeline_secret_2026

# Optional: Google AI Studio API Key for local LLM routing & synthesis
GEMINI_API_KEY=

# Optional: Path to local Google OAuth token (if using direct Google Sheets API)
GOOGLE_TOKEN_PATH=local_auth/token.json
